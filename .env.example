# arx configuration. Copy to `.env` and fill in what you use.
#
# Nothing here is required. Every setting has an offline default, and
# `arx doctor` reports what this install can actually do.

# --- reasoning layer -------------------------------------------------------
# An OpenAI-compatible chat endpoint. Leave both blank to run with the null
# model, which proposes nothing and never fails.
ARX_LLM_BASE_URL=
ARX_LLM_API_KEY=
ARX_LLM_MODEL=

# --- Zotero (optional, off by default) --------------------------------------
# When enabled, every citation in a report must resolve in your library.
ARX_ZOTERO_ENABLED=0
ARX_ZOTERO_API_URL=http://localhost:23119/api
ARX_ZOTERO_LIBRARY_ID=
ARX_ZOTERO_API_KEY=

# --- the gate ----------------------------------------------------------------
# Declared separation threshold: the smallest margin you would report as a
# finding on its own. The MDE competes with this, so raising it makes the
# gate stricter without any change to the data.
ARX_GATE_DELTA=0.02
ARX_GATE_ALPHA=0.05
ARX_GATE_POWER=0.8
# 1 = only READABLE findings are written up. 0 = MARGINAL is accepted too.
ARX_GATE_STRICT=1
# 0 disables the gate entirely. This is recorded in the ledger, so a gated
# and an ungated run can never be confused for one another afterwards.
ARX_GATE_ENABLED=1

# --- budget ------------------------------------------------------------------
# All four are independent: exhausting one disqualifies its actions, and only
# the wall clock halts the whole run.
ARX_MAX_ITERATIONS=50
ARX_MAX_LLM_CALLS=200
ARX_MAX_EXPERIMENT_RUNS=12
ARX_MAX_LITERATURE_SWEEPS=3
ARX_MAX_WALL_SECONDS=1800

# --- Goodhart monitor ---------------------------------------------------------
# The scheduler's predicted information gain is compared against the gate's
# actual verdict over a window. Correlation below the threshold means the
# heuristic has drifted and the run records a recalibration event.
ARX_GOODHART_WINDOW=30
ARX_GOODHART_THRESHOLD=0.3
ARX_GOODHART_MIN_SAMPLES=10

# --- experiments ---------------------------------------------------------------
# Composited experiments write here. Keep it out of version control.
ARX_WORKSPACE=./arx_workspace
# Hard timeout for one experiment subprocess, in seconds.
ARX_SANDBOX_TIMEOUT=600
# Determinism: the same seed gives the same bootstrap resampling, so a replay
# reproduces the MDE exactly.
ARX_SEED=0

# --- long-term memory (off by default) ----------------------------------------
# When positive, near-duplicate hypotheses are detected against a global
# ledger. 0 keeps everything in one run's workspace. The database lives in the
# home directory, never in the repository.
ARX_DUPLICATE_THRESHOLD=0.0
ARX_GLOBAL_LEDGER=~/.arx/global_ledger.db

# --- usage oracle ---------------------------------------------------------------
# When set, LLM call counts are written here so the budget a run reports about
# itself can be reconciled against an external record. See docs/ledger.md.
ARX_ORACLE_LOG=

# --- already-wired knobs, undocumented by default -----------------------------
ARX_LLM_TEMPERATURE=0.2
ARX_LLM_TIMEOUT=120
ARX_SEARCH_MAX_RESULTS=20
# Steps with no change to the hypothesis/accepted/rejected/untested counts
# before the run decides it is going in circles and stops.
ARX_STALL_LIMIT=6
# Use a signed ledger when the [provenance] extra is installed. Not a
# general provenance switch: SignedLedger is a separate class that the agent
# does not construct, so this setting is read by your own code and by
# `python3 -c "from arx.experiments import SignedLedger"`, not by `arx run`.
# A hash chain proves consistency, a signature proves authorship -- conflating
# the two is why the two are not one flag.
ARX_SIGN_LEDGER=0
ARX_CITATION_CHECK=1
ARX_VERBOSE=0
# Embeddings for the long-term ledger. "hash" is offline and reproducible;
# "sentence-transformers" needs the [longterm] extra.
ARX_EMBEDDER=hash
ARX_SEMANTIC_TOP_K=10
# Defaults for a run started without --theory-root / --falsified-by.
ARX_THEORY_ROOT=
ARX_THEORY_FALSIFIED_BY=
