# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Environments & credentials -- never commit an API key.
.env
.venv/
venv/
*.venv

# arx workspace output: run artifacts, ledgers, reports.
# These are produced by a run, not part of the source.
arx_workspace/
workspace/
ledger.jsonl
*.ledger.jsonl
*.anchor.json
*.log

# Global long-term ledger lives in the home directory, never in the repo.
~/.arx/

# Example scratch: regenerated by every example run, so it is build output.
examples/_out/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Packaging
build/
dist/
*.egg-info/
paper/main.aux
paper/main.log
paper/main.out
paper/missfont.log
